# Optional public site URL used for Open Graph / canonical tags on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional CoinGecko Demo/Pro key. Leave empty to use the public API.
# Server-side only — never expose this in client code.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
